# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by the "Add rider" button and the seed script. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — used only by `npm run seed:users`
SEED_ADMIN_EMAIL=admin@pahuway.cafe
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026
SEED_RIDER_EMAIL=rider@pahuway.cafe
SEED_RIDER_PASSWORD=ChangeMe-Rider-2026

# Optional — push notifications for the Isla mobile app (see docs/MOBILE.md)
PUSH_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=cafe.pahuway.isla

# Optional — online payments via HitPay (see docs/PAYMENTS.md)
HITPAY_API_KEY=
HITPAY_SALT=
HITPAY_ENV=sandbox
NEXT_PUBLIC_SITE_URL=https://pahuway-cafe.vercel.app

# Optional — SMS for scooter bookings via Semaphore (see docs/RENTALS.md)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Optional — Google Maps for the delivery map + address suggestions (see docs/MAPS.md).
# Browser key: restrict it to your website in Google Cloud. Without it the site uses OpenStreetMap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional — a Map ID from Google Cloud (Map management); defaults to Google's demo style.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
